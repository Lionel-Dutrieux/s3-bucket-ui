    "@aws-sdk/s3-presigned-post": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@azure/storage-blob": "^12.33.0",
    "@better-auth/sso": "^1.7.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "basic-ftp": "^6.2.1",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "files-sdk": "^2.6.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "simple-icons": "^16.32.0",
